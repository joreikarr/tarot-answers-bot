[Unit]
Description=Tarot Answer Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/storage/tarot-answers-bot
EnvironmentFile=/mnt/storage/tarot-answers-bot/.env
ExecStart=/mnt/storage/tarot-answers-bot/venv/bin/python -m tarot_answer_bot.main
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
